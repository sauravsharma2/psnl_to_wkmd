Ingested Last Period =
VAR EndD = [Snap Period End]
RETURN
    SWITCH ( [Grain Sel],
        0, CALCULATE ( [Ingested Records], REMOVEFILTERS ( Date_Ingest ),
                       Date_Ingest[SnapWeekEnd] = EndD ),
        1, CALCULATE ( [Ingested Records], REMOVEFILTERS ( Date_Ingest ),
                       Date_Ingest[YearMonth] = FORMAT ( EndD, "yyyy-MM" ) ),
        2, CALCULATE ( [Ingested Records], REMOVEFILTERS ( Date_Ingest ),
                       Date_Ingest[Year] = YEAR ( EndD ) )
    )
