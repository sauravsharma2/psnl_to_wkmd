Ingested Last Period =
VAR StartD = [Snap Period Start]
VAR EndD   = [Snap Period End]
RETURN
    CALCULATE ( [Ingested Records],
        REMOVEFILTERS ( Date_Ingest ),
        Date_Ingest[Date] >= StartD,
        Date_Ingest[Date] <  EndD )

Matched Period (Snap) =
VAR StartD = [Snap Period Start]
VAR EndD   = [Snap Period End]
RETURN
    CALCULATE ( [Total Matches],
        REMOVEFILTERS ( DateTable ),
        DateTable[Date] >= StartD,
        DateTable[Date] <  EndD,
        TREATAS ( VALUES ( Dim_Country[Country] ), CrossRef_Matches[Country] ) )
