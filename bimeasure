Added Last Month (Snap) =
VAR LastW = MAX ( Snap_W[SnapshotDate] )
VAR LastM = MAX ( Snap_M[SnapshotDate] )
VAR PrevM = CALCULATE ( MAX ( Snap_M[SnapshotDate] ), Snap_M[SnapshotDate] < LastM )
VAR MTot  = CALCULATE ( SUM ( Snap_M[Records] ), Snap_M[SnapshotDate] = LastM )
VAR Cur =
    IF ( LastW > LastM,
         CALCULATE ( SUM ( Snap_W[Records] ), Snap_W[SnapshotDate] = LastW ),
         MTot )
VAR Prev =
    IF ( LastW > LastM,
         MTot,
         CALCULATE ( SUM ( Snap_M[Records] ), Snap_M[SnapshotDate] = PrevM ) )
RETURN IF ( NOT ISBLANK ( Prev ), Cur - Prev )
